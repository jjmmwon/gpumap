from __future__ import annotations

import numpy as np
import cupy as cp

from proumap.types import ProUMAPConfig

ArrayLike = np.ndarray | cp.ndarray

class ProUMAPImpl:
    def __init__(self, config: ProUMAPConfig) -> None: ...
    def close(self) -> None: ...
    def append(self, data_chunk: ArrayLike) -> None: ...
    def run_nn(self, chunk_size: int) -> None: ...
    def run_embedding(self, chunk_size: int) -> None: ...
    def get_embeddings(self) -> ArrayLike: ...
    def get_current_status(self) -> dict: ...
