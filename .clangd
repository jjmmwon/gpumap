CompileFlags:
  CompilationDatabase: build/dev
  Add:
    - "-x"
    - "cuda"
    - "--cuda-host-only"
    - "--no-cuda-version-check"
    - "-Wno-unknown-cuda-version"
    - "-Xclang"
    - "-fcuda-allow-variadic-functions"
    - "-DCCCL_DISABLE_PDL"
    - "-DCUB_DISABLE_NAMESPACE_MAGIC"
    - "-DCUB_IGNORE_NAMESPACE_MAGIC_ERROR"
    - "-DCUVS_BUILD_CAGRA_HNSWLIB"
    - "-DLIBCUDACXX_ENABLE_EXPERIMENTAL_MEMORY_RESOURCE"
    - "-DRAFT_LOG_ACTIVE_LEVEL=RAPIDS_LOGGER_LOG_LEVEL_INFO"
    - "-DRAFT_SYSTEM_LITTLE_ENDIAN=1"
    - "-DTHRUST_DEVICE_SYSTEM=THRUST_DEVICE_SYSTEM_CUDA"
    - "-DTHRUST_DISABLE_ABI_NAMESPACE"
    - "-DTHRUST_HOST_SYSTEM=THRUST_HOST_SYSTEM_CPP"
    - "-DTHRUST_IGNORE_ABI_NAMESPACE_ERROR"
    - "-I/home/myeongwon/git/gpumap-seq/cpp/include"
    - "-I/home/myeongwon/git/gpumap-seq/cpp/src"
    - "-I/home/myeongwon/miniforge3/envs/gpumap/include"
    - "-I/home/myeongwon/miniforge3/envs/gpumap/include/rapids"
    - "-isystem"
    - "/home/myeongwon/miniforge3/envs/gpumap/targets/x86_64-linux/include"
  Remove:
    - "-fcoroutines"
    - "-gpu=*"
    - "-stdpar*"
    - "-arch*"
    - "-gencode*"
    - "--generate-code*"
    - "-ccbin*"
    - "-t=*"
    - "--threads*"
    - "-Xptxas*"
    - "-Xcudafe*"
    - "-Xfatbin*"
    - "-Xcompiler*"
    - "--diag-suppress*"
    - "--diag_suppress*"
    - "--compiler-options*"
    - "--expt-extended-lambda"
    - "--expt-relaxed-constexpr"
    - "-forward-unknown-to-host-compiler"
    - "-Werror=cross-execution-space-call"
    - "-rdc=true"

Diagnostics:
  Suppress:
    - "non_type_template_in_nested_name_specifier"
    - "typecheck_decl_incomplete_type"
    - "no_member_template"
  UnusedIncludes: None

Index:
  Background: Build
